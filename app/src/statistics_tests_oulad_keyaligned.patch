+def attach_keys(df: pd.DataFrame) -> pd.DataFrame:
+    """Replaces each model's positional row_index with the KEY columns of the exact
+    frame train_evaluate_oulad.py indexed into, and checks y_true against it."""
+    target = load_target()
+    parts = []
+    for model, g in df.groupby("model"):
+        if model == BASELINE_MODEL:
+            frame = target
+        else:
+            feats = load_feature_set(model)
+            if feats is None:
+                raise FileNotFoundError(f"Feature set for model {model} not found.")
+            frame = target.merge(feats, on=KEY, how="inner")
+        idx = g["row_index"].to_numpy()
+        keys = frame.iloc[idx][KEY + ["target"]].reset_index(drop=True)
+        g = g.reset_index(drop=True)
+        if not (keys["target"].to_numpy() == g["y_true"].to_numpy()).all():
+            raise ValueError(f"y_true does not match the target at the mapped keys for {model}.")
+        parts.append(pd.concat([keys[KEY], g.drop(columns=["row_index"])], axis=1))
+    return pd.concat(parts, ignore_index=True)
 
 
